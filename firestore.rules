// =====================================================================
//  Firestore 安全規則(新版平台用)— 專案 kb-platform-1
//  做法:保留舊規則(舊版網站與備援仍可運作),新增新版平台用的 kb_v2 與 kb_v2_audit 兩個集合。
//  貼上位置:Firebase 控制台 → Firestore Database → 規則 → 取代全部內容 → 發布
//  貼上前請先把「現有規則」整段複製存檔,出問題時可以貼回去還原。
//
//  【重要說明】新版採「簡易帳號」:帳號與(加密後的)密碼存在資料庫裡,網頁不需要 Firebase 登入。
//  因此規則只能限制「可以寫什麼格式」,無法限制「是誰在寫」。這適合小型研究班級使用;
//  若日後要對外公開或規模變大,請改用 Firebase Authentication。
// =====================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- 新版平台 ----
    // 使用者、班級、組別、討論區、回收桶、設定、貼文(每 500 則一份文件)
    match /kb_v2/{docId} {
      allow read: if true;
      allow create, update: if (docId in ['users', 'classes', 'groups', 'topics', 'trash', 'settings']
                                || docId.matches('nodes__[A-Za-z0-9_-]+__[0-9]+'))
        && request.resource.data.keys().hasOnly(['items', 'value'])
        && (!('items' in request.resource.data) || (request.resource.data.items is map && request.resource.data.items.size() <= 2000));
      allow delete: if false;
    }

    // 稽核紀錄:每天一份文件,只能新增與更新
    match /kb_v2_audit/{day} {
      allow read: if true;
      allow create, update: if day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is map
        && request.resource.data.items.size() <= 5000;
      allow delete: if false;
    }

    // ---- 舊版(保留,讓舊網站與備援可用;確定不再需要後可以刪掉這兩段) ----
    match /kb_platform/{docId} {
      allow read: if docId.matches('class_data_v[0-9]+_.*');
      allow create, update: if docId.matches('class_data_v[0-9]+_.*')
        && request.resource.data.keys().hasOnly(['userList', 'topics', 'nodes', 'trash'])
        && request.resource.data.nodes is list
        && request.resource.data.nodes.size() <= 5000
        && request.resource.data.topics is list
        && request.resource.data.topics.size() <= 50
        && request.resource.data.userList is map
        && request.resource.data.trash is list;
      allow delete: if false;
    }
    match /kb_users/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // 其他所有路徑一律關閉
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
